APP_ENV=production
APP_BASE_URL=https://bni.crosschapp.de
CROSSCHAPP_DB_DRIVER=mysql
CROSSCHAPP_DB_HOST=db
CROSSCHAPP_DB_PORT=3306
CROSSCHAPP_DB_NAME=crosschapp
CROSSCHAPP_DB_USER=crosschapp
CROSSCHAPP_DB_PASSWORD=replace-with-strong-secret
CROSSCHAPP_DB_ROOT_PASSWORD=replace-with-different-strong-secret
CROSSCHAPP_TRUSTED_PROXIES=172.30.0.1
# Optional; technischer Default ist 1800 Sekunden.
# CROSSCHAPP_WATCHLIST_INTERVAL_SECONDS=1800

# Web Push ist ohne diese Konfiguration deaktiviert. Keine echten Schlüssel versionieren.
# Stabilen VAPID-Schlüssel extern erzeugen und nur in der lokalen Server-ENV hinterlegen.
CROSSCHAPP_VAPID_PUBLIC_KEY=
CROSSCHAPP_VAPID_PRIVATE_KEY=
CROSSCHAPP_VAPID_SUBJECT=
# Subject: mailto:kontakt@example.org oder eine HTTPS-Kontaktadresse.
